# ---------------------------------------------------------------------------
# JRS Civil Works Ltd — environment variables
# Copy to `.env.local` for development, or set these in your hosting provider.
# The site builds and runs with none of them set; the enquiry form then logs
# submissions to the server console instead of delivering them.
# ---------------------------------------------------------------------------

# Option A — forward every enquiry to any HTTPS endpoint (Formspree, Zapier,
# Make, n8n, a Google Apps Script, your own CRM). Takes precedence over email.
ENQUIRY_WEBHOOK_URL=

# Option B — deliver by email through Resend (https://resend.com).
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
# Must be a verified sender on your Resend domain.
ENQUIRY_FROM_EMAIL=enquiries@jrscivilworksltd.com
